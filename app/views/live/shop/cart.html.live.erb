<div class="card bg-base-100 shadow-xl sticky top-4">
  <div class="card-body">
    <h2 class="card-title text-2xl mb-4">
      Shopping Cart
      <%# Shown whenever the component root carries live-loading %>
      <span class="live-spinner loading loading-spinner loading-sm text-primary"></span>
      <% if component.item_count > 0 %>
        <span class="badge badge-primary badge-lg"><%= component.item_count %></span>
      <% end %>
    </h2>

    <div class="text-center py-8 text-base-content/50 <%= 'hidden' if component.item_count > 0 %>">
      <div class="text-4xl mb-2">🛒</div>
      <p>Your cart is empty</p>
    </div>

    <div class="<%= 'hidden' if component.item_count == 0 %>">
      <div class="space-y-3 mb-4">
        <% component.cart_items_array.each do |item| %>
          <div class="flex items-center gap-3 p-3 bg-base-200 rounded-lg" live-key="<%= item[:product_id] %>">
            <div class="flex-1">
              <h4 class="font-semibold"><%= item[:name] %></h4>
              <p class="text-sm text-base-content/70">$<%= number_with_precision(item[:price], precision: 2) %> each</p>
            </div>

            <div class="flex items-center gap-2">
              <button class="btn btn-sm btn-circle"
                      live-action="decrease_quantity"
                      live-value-product-id="<%= item[:product_id] %>">
                -
              </button>
              <span class="font-bold w-8 text-center"><%= item[:quantity] %></span>
              <button class="btn btn-sm btn-circle"
                      live-action="increase_quantity"
                      live-value-product-id="<%= item[:product_id] %>">
                +
              </button>
            </div>

            <div class="text-right min-w-[80px]">
              <div class="font-bold">$<%= number_with_precision(item[:price] * item[:quantity], precision: 2) %></div>
            </div>

            <button class="btn btn-sm btn-ghost btn-circle"
                    live-action="remove_item"
                    live-value-product-id="<%= item[:product_id] %>">
              ✕
            </button>
          </div>
        <% end %>
      </div>

      <div class="divider"></div>

      <div class="space-y-2">
        <div class="flex justify-between text-base-content/70">
          <span>Subtotal:</span>
          <span>$<%= number_with_precision(component.subtotal, precision: 2) %></span>
        </div>
        <div class="flex justify-between text-base-content/70">
          <span>Tax (8%):</span>
          <span>$<%= number_with_precision(component.tax, precision: 2) %></span>
        </div>
        <div class="divider my-2"></div>
        <div class="flex justify-between text-xl font-bold">
          <span>Total:</span>
          <span class="text-primary">$<%= number_with_precision(component.total, precision: 2) %></span>
        </div>
      </div>

      <div class="card-actions flex-col w-full mt-4 gap-2">
        <%# live-disable-with prevents a double charge and swaps the label
            while the checkout round trip is in flight %>
        <button class="btn btn-primary btn-block"
                live-action="checkout"
                live-disable-with="Processing payment…">
          Checkout
        </button>
        <button class="btn btn-ghost btn-sm btn-block"
                live-action="clear_cart"
                live-disable-with>
          Clear Cart
        </button>
      </div>
    </div>
  </div>
</div>
