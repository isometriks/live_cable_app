{% yield live_component(class: "flex justify-center items-center") do %}
  <div class="card bg-base-100 shadow-xl w-full max-w-md">
    <div class="card-body p-6">
      <h2 class="card-title text-2xl font-bold mb-4">User Information</h2>

      <div class="form-control w-full mb-3">
        <label class="label">
          <span class="label-text">First Name</span>
        </label>
        <input type="text"
               placeholder="Enter first name"
               class="input input-bordered w-full"
               data-state="first_name" />
      </div>

      <div class="form-control w-full mb-3">
        <label class="label">
          <span class="label-text">Last Name</span>
        </label>
        <input type="text"
               placeholder="Enter last name"
               class="input input-bordered w-full"
               data-state="last_name" />
      </div>

      <div class="form-control w-full mb-4">
        <label class="label">
          <span class="label-text">Email</span>
        </label>
        <input type="email"
               placeholder="Enter email"
               class="input input-bordered w-full"
               data-state="email" />
      </div>

      <div class="card-actions justify-end">
        <button class="btn btn-primary"
                data-action="live#call"
                data-live-action-param="confirm">
          Save
        </button>
      </div>
    </div>
  </div>

  {{ render(dialog) }}
{% endyield %}
